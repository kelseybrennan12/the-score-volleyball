#!/usr/bin/env bash
#MISE description="Execute backend integration tests through the canonical task surface"
#MISE depends=["test:image:prepare"]

set -euo pipefail

cd "${MISE_PROJECT_ROOT:?}"

if [[ "${1:-}" == "--" ]]; then
  shift
fi

if [[ "$#" -gt 0 ]]; then
  mise run test-integration -- "$@"
else
  mise run test-integration
fi
