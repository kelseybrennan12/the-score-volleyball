#!/usr/bin/env bash
#MISE description="Open a shell in the GitHub-like Lima VM"
#MISE depends=["vm:gh:ensure"]

set -euo pipefail

default_vm_name() {
  local repo_root="${MISE_PROJECT_ROOT:?}"
  local repo_basename=""

  repo_basename="$(basename "${repo_root}")"
  repo_basename="${repo_basename//[^[:alnum:]]/-}"
  repo_basename="${repo_basename#-}"
  repo_basename="${repo_basename%-}"

  if [[ -z "${repo_basename}" ]]; then
    repo_basename="workspace"
  fi

  printf 'starter-gh-%s\n' "${repo_basename}"
}

vm_name="${STARTER_GH_VM_NAME:-$(default_vm_name)}"
repo_mount="${STARTER_GH_VM_MOUNT:-${MISE_PROJECT_ROOT:?}}"
exec limactl shell --workdir "${repo_mount}" "${vm_name}"
