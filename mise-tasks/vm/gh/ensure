#!/usr/bin/env bash
#MISE description="Ensure the GitHub-like Lima VM exists and is running"

set -euo pipefail

cd "${MISE_PROJECT_ROOT:?}"

if [[ "$(uname -s)" != "Darwin" ]]; then
  printf >&2 '%s\n' "vm:gh:* is only supported on macOS hosts with Lima."
  exit 1
fi

if ! command -v limactl >/dev/null 2>&1; then
  printf >&2 '%s\n' "limactl is required. Install Lima first."
  exit 1
fi

default_vm_name() {
  local repo_basename=""

  repo_basename="$(basename "${MISE_PROJECT_ROOT}")"
  repo_basename="${repo_basename//[^[:alnum:]]/-}"
  repo_basename="${repo_basename#-}"
  repo_basename="${repo_basename%-}"

  if [[ -z "${repo_basename}" ]]; then
    repo_basename="workspace"
  fi

  printf 'starter-gh-%s\n' "${repo_basename}"
}

ensure_guest_mise() {
  local guest_setup_script=""

  read -r -d '' guest_setup_script <<'EOF' || true
set -euo pipefail

mise_bin="$HOME/.local/bin/mise"
export PATH="$HOME/.local/bin:$PATH"

append_once() {
  local target_file="$1"
  local marker="$2"
  local block="$3"

  touch "${target_file}"
  if ! grep -Fq "${marker}" "${target_file}"; then
    printf '\n%s\n' "${block}" >>"${target_file}"
  fi
}

mise_is_healthy() {
  [[ -s "${mise_bin}" ]] && "${mise_bin}" --version >/dev/null 2>&1
}

if ! mise_is_healthy; then
  rm -f "${mise_bin}"
  curl https://mise.run | sh
fi

if ! mise_is_healthy; then
  printf >&2 '%s\n' "mise installation inside the guest is incomplete or corrupted"
  exit 1
fi

append_once "${HOME}/.profile" "# Added by Starter vm:gh:ensure: mise path" \
'# Added by Starter vm:gh:ensure: mise path
export PATH="$HOME/.local/bin:$PATH"'

append_once "${HOME}/.bashrc" "# Added by Starter vm:gh:ensure: mise activate bash" \
'# Added by Starter vm:gh:ensure: mise activate bash
if [ -x "$HOME/.local/bin/mise" ]; then
  eval "$("$HOME/.local/bin/mise" activate bash)"
fi'

append_once "${HOME}/.zshrc" "# Added by Starter vm:gh:ensure: mise activate zsh" \
'# Added by Starter vm:gh:ensure: mise activate zsh
if [ -x "$HOME/.local/bin/mise" ]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi'
EOF

  limactl shell --workdir "${repo_mount}" "${vm_name}" /bin/bash -lc "${guest_setup_script}"
}

add_rosetta_flag() {
  local -n args_ref=$1

  case "${rosetta_setting}" in
    auto)
      if [[ "$(uname -m)" == "arm64" && "${vm_type}" == "vz" ]]; then
        args_ref+=(--rosetta)
      fi
      ;;
    true)
      args_ref+=(--rosetta)
      ;;
    false)
      ;;
    *)
      printf >&2 'invalid STARTER_GH_VM_ROSETTA value: %s (expected auto|true|false)\n' "${rosetta_setting}"
      exit 1
      ;;
  esac
}

reconcile_existing_vm() {
  local -a edit_args=(
    -y
    --cpus "${vm_cpus}"
    --memory "${vm_memory_gib}"
    --disk "${vm_disk_gib}"
    --mount-only "${repo_mount}:w"
    --mount-type "${mount_type}"
    --start
  )

  add_rosetta_flag edit_args
  limactl edit "${edit_args[@]}" "${vm_name}"
}

vm_name="${STARTER_GH_VM_NAME:-$(default_vm_name)}"
repo_mount="${STARTER_GH_VM_MOUNT:-${MISE_PROJECT_ROOT}}"
vm_cpus="${STARTER_GH_VM_CPUS:-4}"
vm_memory_gib="${STARTER_GH_VM_MEMORY_GIB:-8}"
vm_disk_gib="${STARTER_GH_VM_DISK_GIB:-60}"
vm_type="${STARTER_GH_VM_TYPE:-vz}"
mount_type="${STARTER_GH_VM_MOUNT_TYPE:-virtiofs}"
rosetta_setting="${STARTER_GH_VM_ROSETTA:-auto}"
template_path="${MISE_PROJECT_ROOT}/infra/lima/github-like.yaml"

if [[ "${repo_mount}" != /* ]]; then
  printf >&2 'repo mount must be an absolute path: %s\n' "${repo_mount}"
  exit 1
fi

if [[ ! -d "${repo_mount}" ]]; then
  printf >&2 'repo mount path does not exist: %s\n' "${repo_mount}"
  exit 1
fi

if [[ ! -f "${template_path}" ]]; then
  printf >&2 'missing Lima template: %s\n' "${template_path}"
  exit 1
fi

limactl validate "${template_path}" >/dev/null

existing_status="$(limactl list "${vm_name}" --format '{{.Status}}' 2>/dev/null || true)"

print_success_summary() {
  local instance_dir=""

  instance_dir="$(limactl list "${vm_name}" --format '{{.Dir}}' 2>/dev/null || true)"

  printf 'ready: %s\n' "${vm_name}"
  printf 'mount: %s\n' "${repo_mount}"
  printf 'shell: limactl shell %s --workdir %s\n' "${vm_name}" "${repo_mount}"
  printf 'guest toolchain: mise installed and shell activation configured\n'
  if [[ -n "${instance_dir}" ]]; then
    printf 'docker context: docker context create lima-%s --docker "host=unix://%s/sock/docker.sock"\n' "${vm_name}" "${instance_dir}"
  fi
}

if [[ -n "${existing_status}" ]]; then
  if [[ "${existing_status}" == "Running" || "${existing_status}" == "Broken" ]]; then
    limactl stop -f "${vm_name}" >/dev/null 2>&1 || true
  fi

  reconcile_existing_vm
  ensure_guest_mise
  print_success_summary
  exit 0
fi

start_args=(
  -y
  --name="${vm_name}"
  --vm-type "${vm_type}"
  --cpus "${vm_cpus}"
  --memory "${vm_memory_gib}"
  --disk "${vm_disk_gib}"
  --mount "${repo_mount}:w"
)

if [[ -n "${mount_type}" ]]; then
  start_args+=(--mount-type "${mount_type}")
fi

add_rosetta_flag start_args

limactl start "${start_args[@]}" "${template_path}"
ensure_guest_mise
print_success_summary
