#!/usr/bin/env node
//MISE description="Sync .env keys and ordering from .env.example"

import fs from "node:fs";
import path from "node:path";
import process from "node:process";

const ENV_FILE = ".env";
const EXAMPLE_FILE = ".env.example";

const assignmentPattern = /^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$/;

const readEnvFile = (filePath) => {
  const content = fs.readFileSync(filePath, "utf8");
  const lines = content.split(/\r?\n/);
  const entries = new Map();
  const keyOrder = [];

  for (const line of lines) {
    const match = assignmentPattern.exec(line);
    if (!match) {
      continue;
    }

    const [, key, value] = match;
    if (!entries.has(key)) {
      keyOrder.push(key);
    }
    entries.set(key, `${key}=${value}`);
  }

  return { content, lines, entries, keyOrder };
};

const buildSyncedEnvContent = (envFile, exampleFile) => {
  const outputLines = [];
  const exampleKeys = new Set(exampleFile.entries.keys());

  for (const line of exampleFile.lines) {
    const match = assignmentPattern.exec(line);
    if (!match) {
      outputLines.push(line);
      continue;
    }

    const [, key] = match;
    outputLines.push(envFile.entries.get(key) ?? line);
  }

  const extraKeys = envFile.keyOrder.filter((key) => !exampleKeys.has(key));
  if (extraKeys.length > 0) {
    if (outputLines.length > 0 && outputLines[outputLines.length - 1] !== "") {
      outputLines.push("");
    }
    outputLines.push("# Local-only keys (not in .env.example)");
    for (const key of extraKeys) {
      const line = envFile.entries.get(key);
      if (line) {
        outputLines.push(line);
      }
    }
  }

  return `${outputLines.join("\n")}\n`;
};

const projectRoot = process.env.MISE_PROJECT_ROOT ?? process.cwd();
const envPath = path.join(projectRoot, ENV_FILE);
const examplePath = path.join(projectRoot, EXAMPLE_FILE);

if (!fs.existsSync(examplePath)) {
  console.error(`Missing ${EXAMPLE_FILE}; cannot compare environment files.`);
  process.exit(1);
}

if (!fs.existsSync(envPath)) {
  fs.copyFileSync(examplePath, envPath);
  console.log(`Created ${ENV_FILE} from ${EXAMPLE_FILE}.`);
}

const env = readEnvFile(envPath);
const example = readEnvFile(examplePath);

const missingKeys = [...example.entries.keys()].filter((key) => !env.entries.has(key));
const extraKeys = [...env.entries.keys()].filter((key) => !example.entries.has(key));

console.log(`Compared ${EXAMPLE_FILE} (${example.entries.size} keys) against ${ENV_FILE} (${env.entries.size} keys).`);

if (missingKeys.length > 0) {
  console.log(`Missing keys in ${ENV_FILE} (${missingKeys.length}):`);
  for (const key of missingKeys) {
    console.log(`- ${key}`);
  }
} else {
  console.log(`No missing keys in ${ENV_FILE}.`);
}

if (extraKeys.length > 0) {
  console.log(`Extra keys in ${ENV_FILE} (${extraKeys.length}):`);
  for (const key of extraKeys) {
    console.log(`- ${key}`);
  }
}

const syncedContent = buildSyncedEnvContent(env, example);
const tempPath = `${envPath}.tmp-${process.pid}`;
fs.writeFileSync(tempPath, syncedContent, "utf8");
fs.renameSync(tempPath, envPath);
console.log(
  `Rewrote ${ENV_FILE} using ${EXAMPLE_FILE} ordering/comments, filled ${missingKeys.length} missing key(s), preserved ${extraKeys.length} local-only key(s).`,
);
