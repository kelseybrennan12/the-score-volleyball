#!/usr/bin/env node
//MISE description="Run advisory dependency-currency checks"
//MISE tools={node="latest"}

import { execFileSync } from "node:child_process";
import { readFile } from "node:fs/promises";
import process from "node:process";

process.chdir(process.env.MISE_PROJECT_ROOT ?? process.cwd());

const DEFAULT_TIMEOUT_MS = 8000;
const USER_AGENT = "project-starter-dependency-currency/1.0";
const FETCH_RETRY_ATTEMPTS = 3;
const FETCH_RETRY_BASE_DELAY_MS = 250;

async function main() {
  const args = parseArgs(process.argv.slice(2));

  if (args.help) {
    printHelp();
    return;
  }

  const packageJson = await readJson("package.json");
  const npmVersions = await collectNpmSurface(packageJson);
  const toolchainVersions = await collectToolchainSurface();
  const containerVersions = await collectContainerSurface();

  const surfaces = [npmVersions, toolchainVersions, containerVersions]
    .map((surface) => ({
      ...surface,
      entries: sortEntries(surface.entries),
    }))
    .sort((a, b) => a.surface.localeCompare(b.surface));

  const summary = summarize(surfaces);
  printCheckSummary(surfaces, summary);
}

function parseArgs(argv) {
  const args = {
    help: false,
  };

  for (const token of argv) {
    if (token === "--help" || token === "-h") {
      args.help = true;
      continue;
    }

    throw new Error(`Unknown argument: ${token}`);
  }

  return args;
}

function printHelp() {
  console.log("Usage: mise run deps:check");
  console.log("  Runs advisory dependency-currency checks and prints a summary.");
}

async function collectNpmSurface(packageJson) {
  const dependencyGroups = [
    ["dependencies", packageJson.dependencies ?? {}],
    ["devDependencies", packageJson.devDependencies ?? {}],
  ];

  const lockfileVersions = await parseRootImporterVersionsFromLockfile("pnpm-lock.yaml");

  const items = [];
  for (const [group, entries] of dependencyGroups) {
    for (const [name, declared] of Object.entries(entries)) {
      const current = lockfileVersions.get(name) ?? normalizeDeclaredVersion(declared);
      items.push({
        name,
        group,
        declared,
        current,
      });
    }
  }

  items.sort((a, b) => a.name.localeCompare(b.name));

  const latestByName = new Map();
  await mapLimit(items, 6, async (item) => {
    const latest = await fetchNpmLatestVersion(item.name);
    latestByName.set(item.name, latest);
  });

  const entries = items.map((item) => {
    const latest = latestByName.get(item.name);
    const status = compareVersions(item.current, latest.version);

    return {
      name: item.name,
      group: item.group,
      declared: item.declared,
      current: item.current,
      latest: latest.version,
      status: latest.error ? "error" : status,
      source: "package.json + pnpm-lock.yaml",
      error: latest.error,
    };
  });

  return {
    surface: "npm",
    source: ["package.json", "pnpm-lock.yaml", "npm registry"],
    entries,
  };
}

async function parseRootImporterVersionsFromLockfile(lockfilePath) {
  const versions = new Map();
  let contents;

  try {
    contents = await readFile(lockfilePath, "utf8");
  } catch {
    return versions;
  }

  const lines = contents.split(/\r?\n/);

  let inImporters = false;
  let inRootImporter = false;
  let currentSection = null;
  let currentPackage = null;

  for (const line of lines) {
    if (!inImporters) {
      if (line.trim() === "importers:") {
        inImporters = true;
      }
      continue;
    }

    if (!inRootImporter) {
      if (line === "  .:") {
        inRootImporter = true;
      } else if (/^  [^\s].*:/.test(line)) {
        break;
      }
      continue;
    }

    if (/^  [^\s].*:/.test(line) && line !== "  .:") {
      break;
    }

    const sectionMatch = line.match(/^    (dependencies|devDependencies):\s*$/);
    if (sectionMatch) {
      currentSection = sectionMatch[1];
      currentPackage = null;
      continue;
    }

    if (/^    [^\s].*:/.test(line) && !sectionMatch) {
      currentSection = null;
      currentPackage = null;
      continue;
    }

    if (!currentSection) {
      continue;
    }

    const packageMatch = line.match(/^      (".*?"|[^:]+):\s*$/);
    if (packageMatch) {
      currentPackage = packageMatch[1].replace(/^"|"$/g, "");
      continue;
    }

    const versionMatch = line.match(/^        version:\s+(.+)$/);
    if (versionMatch && currentPackage) {
      const normalizedVersion = normalizeResolvedVersion(versionMatch[1]);
      versions.set(currentPackage, normalizedVersion);
    }
  }

  return versions;
}

function normalizeResolvedVersion(versionField) {
  const unquoted = versionField.replace(/^"|"$/g, "").trim();
  return unquoted.split("(")[0].trim();
}

function normalizeDeclaredVersion(version) {
  const normalized = String(version ?? "").trim();
  return normalized.replace(/^[~^><=\s]*/, "");
}

async function fetchNpmLatestVersion(packageName) {
  const encodedName = encodeURIComponent(packageName);
  const url = `https://registry.npmjs.org/${encodedName}/latest`;

  try {
    const body = await fetchJson(url);
    return {
      version: typeof body.version === "string" ? body.version : null,
      error: null,
    };
  } catch (error) {
    return {
      version: null,
      error: formatError(error),
    };
  }
}

async function collectToolchainSurface() {
  const tools = await collectDeclaredTaskTools();
  const entries = [];

  const sortedTools = [...tools.entries()].sort(([a], [b]) => a.localeCompare(b));

  for (const [tool, metadata] of sortedTools) {
    const configured = [...metadata.versions].sort().join("|");
    const latest = runCommand("mise", ["latest", tool]);
    const active = detectActiveToolVersion(tool);

    const preferredDeclaredVersion = [...metadata.versions][0] ?? "";
    const current = active ?? normalizeDeclaredVersion(preferredDeclaredVersion);
    const treatLatestSpecifierAsUpToDate = metadata.versions.size === 1 && metadata.versions.has("latest") && !active;
    const status = latest.error ? "error" : compareVersions(current, latest.value, treatLatestSpecifierAsUpToDate);

    entries.push({
      name: tool,
      group: "tool",
      declared: configured,
      current,
      latest: latest.value,
      status,
      source: `mise task tools (${[...metadata.tasks].sort().join(", ")}) + mise latest`,
      error: latest.error,
    });
  }

  return {
    surface: "toolchain",
    source: ["mise task tools", "mise latest"],
    entries,
  };
}

function detectActiveToolVersion(tool) {
  const toolCommand = getToolVersionCommand(tool);
  if (!toolCommand) {
    return null;
  }

  const result = runCommand(toolCommand[0], toolCommand.slice(1));
  if (result.error || !result.value) {
    return null;
  }

  return normalizeVersionToken(result.value);
}

function getToolVersionCommand(tool) {
  switch (tool) {
    case "node":
      return ["node", "--version"];
    case "pnpm":
      return ["pnpm", "--version"];
    case "gh":
      return ["gh", "--version"];
    case "uv":
      return ["uv", "--version"];
    case "fd":
      return ["fd", "--version"];
    case "azure-cli":
      return ["az", "version", "--query", '"azure-cli"', "--output", "tsv"];
    default:
      return null;
  }
}

async function collectDeclaredTaskTools() {
  const tools = new Map();
  await collectTomlTaskTools("mise.toml", tools);
  await collectFileTaskTools("mise-tasks", tools);
  return tools;
}

async function collectTomlTaskTools(filePath, tools) {
  const text = await readFile(filePath, "utf8");
  const lines = text.split(/\r?\n/);
  let currentTask = null;

  for (const line of lines) {
    const trimmed = line.trim();

    const taskMatch = trimmed.match(/^\[tasks\.(?:"([^"]+)"|([A-Za-z0-9:_-]+))\]$/);
    if (taskMatch) {
      currentTask = taskMatch[1] ?? taskMatch[2];
      continue;
    }

    if (trimmed.startsWith("[") && trimmed.endsWith("]")) {
      currentTask = null;
    }

    if (!currentTask || trimmed === "" || trimmed.startsWith("#")) {
      continue;
    }

    const match = trimmed.match(/^tools\s*=\s*\{(.*)\}\s*$/);
    if (match) {
      addToolDeclarations(tools, match[1], currentTask);
    }
  }
}

async function collectFileTaskTools(rootPath, tools) {
  const entries = await readDirSafe(rootPath);

  for (const entry of entries) {
    const relativePath = `${rootPath}/${entry.name}`;
    if (entry.isDirectory()) {
      await collectFileTaskTools(relativePath, tools);
      continue;
    }

    if (entry.name === "README.md" || entry.name === ".DS_Store") {
      continue;
    }

    const text = await readFile(relativePath, "utf8");
    const taskName = toTaskName(relativePath);
    const match = text.match(/^(?:#|\/\/)MISE tools=\{(.*)\}\s*$/m);
    if (match) {
      addToolDeclarations(tools, match[1], taskName);
    }
  }
}

async function readDirSafe(dirPath) {
  try {
    const fs = await import("node:fs/promises");
    return await fs.readdir(dirPath, { withFileTypes: true });
  } catch {
    return [];
  }
}

function toTaskName(filePath) {
  const relative = filePath.replace(/^mise-tasks\//, "");
  const trimmed = relative.endsWith("/_default") ? relative.slice(0, -"/_default".length) : relative;
  return trimmed.split("/").join(":");
}

function addToolDeclarations(tools, declarationText, taskName) {
  const matches = declarationText.matchAll(/([A-Za-z0-9._-]+)\s*=\s*"([^"]+)"/g);

  for (const match of matches) {
    const tool = match[1];
    const version = match[2];
    const metadata = tools.get(tool) ?? { versions: new Set(), tasks: new Set() };
    metadata.versions.add(version);
    metadata.tasks.add(taskName);
    tools.set(tool, metadata);
  }
}

async function collectContainerSurface() {
  const dockerFiles = [
    "infra/docker/docker-compose.yml",
    "infra/docker/docker-compose.test.yml",
    "infra/docker/docker-bake.hcl",
  ];
  const imageRefs = [];

  for (const filePath of dockerFiles) {
    const text = await readFile(filePath, "utf8");
    const matches = text.matchAll(/(?:image:\s*|default\s*=\s*")([A-Za-z0-9./:_-]+)(?:"|$)/g);
    for (const match of matches) {
      const ref = match[1];
      if (ref.includes("${")) {
        continue;
      }
      imageRefs.push(ref);
    }
  }

  const uniqueRefs = [...new Set(imageRefs)].sort();
  const entries = uniqueRefs.map((ref) => {
    const { name, current } = splitImageRef(ref);
    return {
      name,
      group: "image",
      declared: ref,
      current,
      latest: null,
      status: "info",
      source: "docker-compose / docker-bake",
      error: null,
    };
  });

  return {
    surface: "containers",
    source: dockerFiles,
    entries,
  };
}

function splitImageRef(ref) {
  const digestIndex = ref.indexOf("@");
  if (digestIndex >= 0) {
    return {
      name: ref.slice(0, digestIndex),
      current: ref.slice(digestIndex + 1),
    };
  }

  const lastColon = ref.lastIndexOf(":");
  const lastSlash = ref.lastIndexOf("/");
  if (lastColon > lastSlash) {
    return {
      name: ref.slice(0, lastColon),
      current: ref.slice(lastColon + 1),
    };
  }

  return {
    name: ref,
    current: "latest",
  };
}

function compareVersions(current, latest, treatLatestSpecifierAsUpToDate = false) {
  if (!current || !latest) {
    return "unknown";
  }

  if (treatLatestSpecifierAsUpToDate) {
    return "up-to-date";
  }

  const normalizedCurrent = normalizeVersionToken(current);
  const normalizedLatest = normalizeVersionToken(latest);

  if (!normalizedCurrent || !normalizedLatest) {
    return normalizedCurrent === normalizedLatest ? "up-to-date" : "unknown";
  }

  if (normalizedCurrent === normalizedLatest) {
    return "up-to-date";
  }

  return compareSemver(normalizedCurrent, normalizedLatest) >= 0 ? "up-to-date" : "behind";
}

function normalizeVersionToken(value) {
  if (!value) {
    return null;
  }

  const versionMatch = String(value).match(/\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?/);
  return versionMatch ? versionMatch[0] : String(value).trim().replace(/^v/, "");
}

function compareSemver(a, b) {
  const parse = (version) => version.split(/[.-]/).map((part) => Number.parseInt(part, 10) || 0);
  const left = parse(a);
  const right = parse(b);
  const length = Math.max(left.length, right.length);

  for (let index = 0; index < length; index += 1) {
    const diff = (left[index] ?? 0) - (right[index] ?? 0);
    if (diff !== 0) {
      return diff;
    }
  }

  return 0;
}

function sortEntries(entries) {
  return [...entries].sort((a, b) => a.name.localeCompare(b.name));
}

function summarize(surfaces) {
  const entries = surfaces.flatMap((surface) => surface.entries);
  return {
    total: entries.length,
    upToDate: entries.filter((entry) => entry.status === "up-to-date").length,
    behind: entries.filter((entry) => entry.status === "behind").length,
    errors: entries.filter((entry) => entry.status === "error").length,
  };
}

function printCheckSummary(surfaces, summary) {
  console.log("dependency currency summary");
  console.log(`- total: ${summary.total}`);
  console.log(`- up-to-date: ${summary.upToDate}`);
  console.log(`- behind: ${summary.behind}`);
  console.log(`- errors: ${summary.errors}`);

  for (const surface of surfaces) {
    console.log(`\n[${surface.surface}] source: ${surface.source.join(", ")}`);
    for (const entry of surface.entries) {
      const latestLabel = entry.latest ?? "(n/a)";
      const errorLabel = entry.error ? ` error=${entry.error}` : "";
      console.log(
        `- ${entry.name} group=${entry.group} declared=${entry.declared} current=${entry.current} latest=${latestLabel} status=${entry.status}${errorLabel}`,
      );
    }
  }
}

async function readJson(filePath) {
  const text = await readFile(filePath, "utf8");
  return JSON.parse(text);
}

async function fetchJson(url) {
  let attempt = 0;
  let lastError = null;

  while (attempt < FETCH_RETRY_ATTEMPTS) {
    attempt += 1;

    try {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), DEFAULT_TIMEOUT_MS);
      const response = await fetch(url, {
        headers: {
          "user-agent": USER_AGENT,
          accept: "application/json",
        },
        signal: controller.signal,
      });
      clearTimeout(timeout);

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      return await response.json();
    } catch (error) {
      lastError = error;
      if (attempt >= FETCH_RETRY_ATTEMPTS) {
        break;
      }
      await sleep(FETCH_RETRY_BASE_DELAY_MS * attempt);
    }
  }

  throw lastError;
}

function formatError(error) {
  if (!error) {
    return "unknown error";
  }

  if (typeof error === "string") {
    return error;
  }

  if (error instanceof Error) {
    return error.message;
  }

  return JSON.stringify(error);
}

function runCommand(command, args) {
  try {
    const value = execFileSync(command, args, {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "pipe"],
      timeout: DEFAULT_TIMEOUT_MS,
    }).trim();

    return { value, error: null };
  } catch (error) {
    return {
      value: null,
      error: formatError(error),
    };
  }
}

async function mapLimit(items, limit, iteratee) {
  const queue = [...items];
  const workers = Array.from({ length: Math.min(limit, items.length) }, async () => {
    while (queue.length > 0) {
      const item = queue.shift();
      if (item) {
        await iteratee(item);
      }
    }
  });

  await Promise.all(workers);
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

main().catch((error) => {
  console.error(formatError(error));
  process.exit(1);
});
