#!/usr/bin/env bash
#MISE description="Run every CI gate locally, in the same order as .github/workflows/ci.yml"

set -euo pipefail

cd "${MISE_PROJECT_ROOT:?}"

# Sequential on purpose: `next build` rewrites .next/types while `tsc` is reading them,
# so typecheck and build must never run concurrently.
for task in fmt-check lint typecheck test build; do
  echo "==> mise run ${task}"
  mise run "${task}"
done
