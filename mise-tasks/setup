#!/usr/bin/env bash
#MISE description="Install local dev dependencies and hooks"
#MISE depends=["deps:install"]
#MISE tools={node="latest",pnpm="latest",gh="latest",uv="latest",fd="latest",azure-cli="latest"}

set -euo pipefail

cd "${MISE_PROJECT_ROOT:?}"

mise install
mise reshim
pnpm exec playwright install chromium
az bicep version >/dev/null 2>&1 || az bicep install --only-show-errors
mise run hooks-install
