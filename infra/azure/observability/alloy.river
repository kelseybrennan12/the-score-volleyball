logging {
  level = "info"
}

otelcol.receiver.otlp "ingest" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    logs = [otelcol.processor.batch.otel.input]
    metrics = [otelcol.processor.batch.otel.input]
    traces = [otelcol.processor.batch.otel.input]
  }
}

otelcol.processor.batch "otel" {
  send_batch_size = 512
  send_batch_max_size = 1024
  timeout = "1s"

  output {
    logs = [otelcol.processor.filter.otlp_logs.input]
    metrics = [otelcol.exporter.prometheus.default.input]
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.processor.filter "otlp_logs" {
  error_mode = "ignore"

  logs {
    log_record = [
      `resource.attributes["service.name"] == nil`,
      `resource.attributes["service.name"] == "unknown_service"`,
    ]
  }

  output {
    logs = [otelcol.processor.attributes.loki_hints.input]
  }
}

otelcol.processor.attributes "loki_hints" {
  action {
    key = "loki.resource.labels"
    action = "insert"
    value = "service.name,deployment.environment"
  }

  action {
    key = "loki.attribute.labels"
    action = "insert"
    value = "service_name,event,job_type,outcome,error_code"
  }

  output {
    logs = [otelcol.exporter.loki.default.input]
  }
}

otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL") + "/loki/api/v1/push"
  }
}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = sys.env("PROMETHEUS_URL") + "/api/v1/write"
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = sys.env("TEMPO_URL")
    tls {
      insecure = true
    }
  }
}
