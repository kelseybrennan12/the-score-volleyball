{
  "name": "project-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/backend/api.entry.ts",
    "dev:bootstrap": "pnpm run app:drizzle-migrate && tsx src/backend/db-bootstrap.entry.ts",
    "dev:worker": "tsx watch src/backend/worker.entry.ts",
    "dev:idp": "tsx src/backend/idp.entry.ts",
    "dev:frontend": "vite --config src/frontend/vite.config.ts --host 0.0.0.0",
    "app:api": "node dist/backend/api.entry.js",
    "app:idp": "node dist/backend/idp.entry.js",
    "app:bootstrap": "pnpm run app:drizzle-migrate && node dist/backend/db-bootstrap.entry.js",
    "app:drizzle-migrate": "pnpm exec tsx src/backend/db-prepare.entry.ts && pnpm exec drizzle-kit migrate --config drizzle.config.ts",
    "app:worker": "node dist/backend/worker.entry.js",
    "build:frontend": "vite build --config src/frontend/vite.config.ts",
    "build:backend": "vite build --config src/backend/vite.backend.config.ts",
    "build:app": "pnpm run build:frontend && pnpm run build:backend",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "fmt": "prettier . --write && pnpm run lint:fix",
    "fmt-check": "prettier . --check",
    "test": "vitest run src/tests/unit src/tests/contract",
    "test:integration": "vitest run --dir src/tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.31.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.212.0",
    "@opentelemetry/auto-instrumentations-node": "^0.70.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.212.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.212.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-logs": "^0.212.0",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-tooltip": "1.1.8",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.163.3",
    "@trpc/client": "^11.11.0",
    "@trpc/server": "^11.11.0",
    "@trpc/tanstack-react-query": "^11.11.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.7.4",
    "graphile-worker": "^0.16.6",
    "lucide-react": "^0.576.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.19.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "3.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@playwright/test": "1.58.2",
    "@types/node": "^25.3.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10.0.2",
    "prettier": "^3.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass-embedded": "^1.97.3",
    "tailwindcss": "4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
