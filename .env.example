# Core runtime
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
IDP_PORT=3003
WEB_PORT=3002
JOBS_PORT=3001
FRONTEND_PORT=5173
VITE_ENABLE_ADMIN_TAB=false

# Database
POSTGRES_USER=project-starter
POSTGRES_PASSWORD=project-starter
POSTGRES_DB=project-starter
POSTGRES_PORT=5432
TEST_POSTGRES_DB=project-starter_test
TEST_POSTGRES_PORT=5434
TEST_BASE_APP_DB_SCHEMA=public
TEST_JOBS_GRAPHILE_SCHEMA=graphile_worker_test
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
DATABASE_URL=postgres://project-starter:project-starter@postgres:5432/project-starter
TEST_DATABASE_URL=postgres://project-starter:project-starter@test-postgres:5432/project-starter_test
APP_DB_SCHEMA=public
APP_STARTUP_SEED_PACK=baseline
DEV_APP_DB_SCHEMA=app_dev
DEV_JOBS_GRAPHILE_SCHEMA=graphile_worker_dev
DEV_APP_STARTUP_SEED_PACK=baseline
BUILT_APP_DB_SCHEMA=app_built
BUILT_JOBS_GRAPHILE_SCHEMA=graphile_worker_built
BUILT_APP_STARTUP_SEED_PACK=baseline
E2E_BASE_APP_DB_SCHEMA=public
E2E_JOBS_GRAPHILE_SCHEMA=graphile_worker_e2e
E2E_APP_STARTUP_SEED_PACK=none

# Seed behavior
JOBS_POLL_INTERVAL_MS=5000
JOBS_CONCURRENCY=40
JOBS_GRAPHILE_SCHEMA=graphile_worker

# Runtime topology ports
BUILT_WEB_PORT=3102
BUILT_IDP_PORT=3103
E2E_WEB_PORT=3202
E2E_IDP_PORT=3203

# E2E runtime
APP_E2E_SCHEMA_OVERRIDE_ENABLED=false
APP_E2E_SCHEMA_COOKIE_NAME=project-starter-e2e-schema

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3005
LOKI_PORT=3100
TEMPO_PORT=3200
ALLOY_PORT=12345

# OTLP (backend -> alloy)
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
OTEL_EXPORTER_OTLP_TIMEOUT_MS=10000

# Auth / session (API)
AUTH_PROVIDER=dev
AUTH_ISSUER=http://localhost:3003/_dev/idp
AUTH_CLIENT_ID=project-starter-web
AUTH_CLIENT_SECRET=
AUTH_AUDIENCE=project-starter-api
AUTH_SCOPE="openid profile email offline_access"
AUTH_TENANT_ID=dev-tenant
AUTH_SESSION_COOKIE_NAME=project-starter-session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_TIMEOUT_MS=28800000
AUTH_SESSION_MAX_LIFETIME_MS=43200000
AUTH_STATE_TTL_MS=600000
AUTH_SESSION_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
AUTH_ADMIN_GROUP_ID=dev-admin-group
AUTH_USER_GROUP_ID=dev-user-group
AUTH_REDIRECT_URI=
AUTH_POST_LOGIN_REDIRECT=
AUTH_POST_LOGOUT_REDIRECT=

# Azure diagnostics (optional for `mise run azure:*` and `mise run obs:*`)
AZURE_LOG_TAIL=200
AZURE_GRAFANA_URL=
AZURE_GRAFANA_TOKEN=
AZURE_GRAFANA_LOKI_UID=loki
AZURE_GRAFANA_PROMETHEUS_UID=prometheus
AZURE_GRAFANA_TEMPO_UID=tempo
AZURE_OBS_LIMIT=200
AZURE_OBS_WINDOW_NS=3600000000000
