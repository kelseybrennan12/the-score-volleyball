# Admin tool
# Shared passphrase required to open the hidden admin page (triple-tap the
# title on the main viewer, then enter this value).
ADMIN_PASSPHRASE=
# 32+ bytes of random material, used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_COOKIE_SECRET=

# Snapshot storage
# Auto-detected: Blob on Vercel (VERCEL=1), FS locally. Set explicitly to "fs"
# or "blob" to override.
SNAPSHOT_STORAGE=
# Provided automatically by Vercel when a Blob store is linked to the project.
# Only set locally if you want to hit Blob from a dev machine.
BLOB_READ_WRITE_TOKEN=

# Friends-of-the-house teams. Comma-separated `<day>:<team-number>` entries
# (lowercase day name, e.g. `sunday:32,monday:17`). Listed teams get an
# animated gradient header and a waving 👋 on their detail page. Public —
# exposed in the client bundle.
NEXT_PUBLIC_FAVORITE_TEAMS=
